import numpy as np

HOST = "localhost"
USUARIO = "ant"
SENHA = "996385697"
BANCO = "dadosM3"

ARQUIVO_CSV = r"C:\Users\Administrador\Desktop\EXPERIMENTOSLONGOPRAZO\M3\measurements_processado5_preenchido.csv"

colunas_esperadas = [
    "timestamp",
    "temp_1",
    "temp_2",
    "temp_3",
    "temp_4",
    "temp_5",
    "temp_6",
    "temp_7",
    "temp_8",
    "pressao_1",
    "pressao_2",
    "pressao_3",
    "pressao_4",
    "pressao_5",
    "condhot",
    "sec",
    "gor",
    "fluxo_permeado",
    "timestamp_anterior",
    "temp_1_anterior",
    "delta_segundos",
    "tempo_segundos",
    "T_media_quente_C",
    "rho_salmoura_kg_m3",
    "cp_salmoura_J_kgK",
    "m_dot_quente_kg_s",
    "deltaT_quente_C",
    "Q_quente_W",
    "T_ref_C",
    "h_evap_J_kg",
    "vazao_permeado_m3_s",
    "rho_agua_kg_m3",
    "cp_agua_J_kgK",
    "m_dot_frio_kg_s",
    "deltaT_frio_C",
    "Q_frio_W",
    "m_dot_permeado_kg_s",
    "Q_evaporacao_W",
    "GOR_ant",
    "SEC_termico_kWh_m31",
    "SEC_termico_kWh_m3",
    "Balanco_Q",
    "Tempo_dias"
]

try:
    conexao = mysql.connector.connect(
        host=HOST,
        user=USUARIO,
        password=SENHA,
        database=BANCO
    )

    cursor = conexao.cursor()
    print("Conectado ao MySQL.")

    df = pd.read_csv(
        ARQUIVO_CSV,
        sep="/",
        engine="python",
        na_values=["nan", "NaN", "", "None", "NULL"]
    )

    df.columns = (
        df.columns
        .str.strip()
        .str.replace('"', '', regex=False)
        .str.replace("'", "", regex=False)
    )

    print("Colunas encontradas:")
    print(list(df.columns))

    if "id" in df.columns:
        df = df.drop(columns=["id"])

    colunas_faltando = [c for c in colunas_esperadas if c not in df.columns]

    if colunas_faltando:
        print("\nColunas faltando:")
        print(colunas_faltando)
        raise Exception("O CSV não possui todas as colunas necessárias.")

    df = df[colunas_esperadas]

    print("\nCSV carregado e colunas corrigidas com sucesso.")

    cursor.execute("DROP TABLE IF EXISTS measurements")

    cursor.execute("""
    CREATE TABLE measurements (
        timestamp DATETIME(6),

        temp_1 FLOAT,
        temp_2 FLOAT,
        temp_3 FLOAT,
        temp_4 FLOAT,
        temp_5 FLOAT,
        temp_6 FLOAT,
        temp_7 FLOAT,
        temp_8 FLOAT,

        pressao_1 FLOAT,
        pressao_2 FLOAT,
        pressao_3 FLOAT,
        pressao_4 FLOAT,
        pressao_5 FLOAT,

        condhot FLOAT,
        sec FLOAT,
        gor FLOAT,
        fluxo_permeado FLOAT,

        timestamp_anterior DATETIME(6),
        temp_1_anterior FLOAT,
        delta_segundos FLOAT,
        tempo_segundos FLOAT,

        T_media_quente_C FLOAT,
        rho_salmoura_kg_m3 FLOAT,
        cp_salmoura_J_kgK FLOAT,
        m_dot_quente_kg_s FLOAT,
        deltaT_quente_C FLOAT,
        Q_quente_W FLOAT,

        T_ref_C FLOAT,
        h_evap_J_kg FLOAT,
        vazao_permeado_m3_s FLOAT,
        rho_agua_kg_m3 FLOAT,
        cp_agua_J_kgK FLOAT,

        m_dot_frio_kg_s FLOAT,
        deltaT_frio_C FLOAT,
        Q_frio_W FLOAT,

        m_dot_permeado_kg_s FLOAT,
        Q_evaporacao_W FLOAT,

        GOR_ant FLOAT,
        SEC_termico_kWh_m31 FLOAT,
        SEC_termico_kWh_m3 FLOAT,
        Balanco_Q FLOAT,
        Tempo_dias FLOAT
    )
    """)

    print("Tabela recriada.")

    for coluna in ["timestamp", "timestamp_anterior"]:
        df[coluna] = (
            df[coluna]
            .astype(str)
            .str.strip()
            .str.replace('"', '', regex=False)
            .str.replace("'", "", regex=False)
        )

        df[coluna] = pd.to_datetime(
            df[coluna],
            errors="coerce",
            format="mixed"
        )

    print("\nTimestamps inválidos:")
    print("timestamp:", df["timestamp"].isna().sum())
    print("timestamp_anterior:", df["timestamp_anterior"].isna().sum())

    df["timestamp"] = df["timestamp"].dt.strftime("%Y-%m-%d %H:%M:%S.%f")
    df["timestamp_anterior"] = df["timestamp_anterior"].dt.strftime("%Y-%m-%d %H:%M:%S.%f")

    df = df.replace({np.nan: None, pd.NaT: None, "NaT": None, "nan": None})

    sql_insert = f"""
    INSERT INTO measurements (
        {", ".join(colunas_esperadas)}
    )
    VALUES (
        {", ".join(["%s"] * len(colunas_esperadas))}
    )
    """

    dados = [
        tuple(linha[coluna] for coluna in colunas_esperadas)
        for _, linha in df.iterrows()
    ]

    tamanho_lote = 1000
    total_processados = 0

    for i in range(0, len(dados), tamanho_lote):
        lote = dados[i:i + tamanho_lote]
        cursor.executemany(sql_insert, lote)
        conexao.commit()

        total_processados += len(lote)
        print(f"{total_processados} registros processados...")

    print(f"\n{total_processados} registros inseridos com sucesso.")

except Error as e:
    print("\nErro no MySQL:")
    print(e)

except Exception as e:
    print("\nErro:")
    print(e)

finally:
    if "cursor" in locals():
        cursor.close()

    if "conexao" in locals() and conexao.is_connected():
        conexao.close()

    print("\nConexão encerrada.")